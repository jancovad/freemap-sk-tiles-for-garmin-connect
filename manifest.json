{
  "manifest_version": 3,
  "name": "Freemap.sk tiles for Garmin Connect",
  "version": "0.4.1",
  "description": "Pridáva prepínač podkladu Freemap.sk Outdoor do webového Garmin Connect.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connect.garmin.com/*"
      ],
      "js": [
        "src/tile-url.js",
        "src/page-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://connect.garmin.com/*"
      ],
      "js": [
        "src/tile-url.js",
        "src/ui.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
