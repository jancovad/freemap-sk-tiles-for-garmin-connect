{
  "manifest_version": 3,
  "name": "Garmin Freemap Outdoor",
  "version": "0.3.0",
  "description": "Pridáva prepínač podkladu Freemap.sk Outdoor do webového Garmin Connect.",
  "content_scripts": [
    {
      "matches": [
        "https://connect.garmin.com/*"
      ],
      "js": [
        "src/tile-url.js",
        "src/page-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://connect.garmin.com/*"
      ],
      "js": [
        "src/tile-url.js",
        "src/ui.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
